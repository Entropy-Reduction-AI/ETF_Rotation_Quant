<!-- AEM page model -->

<!-- Template structure pages have no /content SPA ancestor; load their own model. -->
<meta property="cq:pagemodel_root_url" content="/content/wpb/hsil/en_hk/indexes/all-indexes/index-details.model.json"/>






<!-- Optional AEM-driven page_name override (author can adapt logic / property) -->
<meta name="hsi:pws:aem:pageName" content=""/>
<meta name="hsi:pws:aem:pageLanguage" content="en-HK"/>
<!-- Inject Tealium data layer BEFORE utag.js so 'b.page_name' exists -->
<script>
  window.utag_cfg_ovrd = window.utag_cfg_ovrd || {};
  window.utag_cfg_ovrd.noview = true;
  window.utag_cfg_ovrd.nocookie = true;
  window.__hsiDeleteUtagMainCookie = window.__hsiDeleteUtagMainCookie || function() {
    var cookieName = 'utag_main';
    var hostname = window.location.hostname || '';
    var pathSegments = (window.location.pathname || '/').split('/').filter(Boolean);
    var domains = [''];
    var paths = ['/'];

    hostname.split('.').forEach(function(_, index, parts) {
      if (index < parts.length - 1) {
        domains.push(parts.slice(index).join('.'));
      }
    });

    pathSegments.reduce(function(path, segment) {
      var nextPath = path + '/' + segment;
      paths.push(nextPath, nextPath + '/');
      return nextPath;
    }, '');

    domains.forEach(function(domain) {
      paths.forEach(function(path) {
        document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0; path=' + path + (domain ? '; domain=' + domain : '') + (window.location.protocol === 'https:' ? '; Secure' : '');
      });
    });
  };
  window.__hsiScheduleUtagMainCookieCleanup = window.__hsiScheduleUtagMainCookieCleanup || function() {
    window.__hsiDeleteUtagMainCookie();
    [100, 500, 1500].forEach(function(delay) {
      window.setTimeout(window.__hsiDeleteUtagMainCookie, delay);
    });
  };
  window.__hsiScheduleUtagMainCookieCleanup();
  window.utag_data = window.utag_data || {};
  console.log('[TL-DIAG][01-header][page] inline tealium config start', {
    pathname: window.location.pathname,
    search: window.location.search,
    noview: window.utag_cfg_ovrd.noview,
    hasUtag: !!window.utag
  });
  var pageTitle = "" || document.title;
  var formattedTitle = pageTitle.replace(/ /g, "_").replace(/_(?=[^_]*_Page$)/, "-");
  if(!window.utag_data.page_name){
     window.utag_data.page_name = "";
  }
  if(!window.utag_data.page_title){
    window.utag_data.page_title = pageTitle;
  }
  window.utag_data.page_path = window.location.pathname || "";
  window.utag_data.page_language = "en\u002DHK" || document.documentElement.lang;
</script>
<!-- Tealium utag footprint START -->
<script type="text/javascript">
    var prodDomain = 'www.hsi.com.hk';
    var env = window.location.hostname.includes(prodDomain) ? 'prod' : 'qa';
    var utagSyncSrc = 'https://tags.tiqcdn.com/utag/hsbc/hk-rbwm-hangseng-hsinet/' + env + '/utag.sync.js';
    var syncScript = document.createElement('script');
    syncScript.src = utagSyncSrc;
    syncScript.type = 'text/javascript';
    syncScript.async = true;
    syncScript.onload = function(){ window.__hsiScheduleUtagMainCookieCleanup && window.__hsiScheduleUtagMainCookieCleanup(); console.log('[TL-DIAG][02-header][page] utag.sync.js loaded', utagSyncSrc); };
    syncScript.onerror = function(){ console.error('[TL-DIAG][02-header][page] utag.sync.js failed', utagSyncSrc); };
    document.head.appendChild(syncScript);

    var utagSrc = 'https://tags.tiqcdn.com/utag/hsbc/hk-rbwm-hangseng-hsinet/' + env + '/utag.js';
    console.log('[TL-DIAG][03-header][page] injecting utag.js', { env: env, utagSrc: utagSrc });
      (function(a,b,c,d){
        a = utagSrc;
        b = document;
        c = 'script';
        d = b.createElement(c);
        d.src = a;
        d.type = 'text/javascript';
        d.async = true;
        d.onload = function(){ window.__hsiScheduleUtagMainCookieCleanup && window.__hsiScheduleUtagMainCookieCleanup(); console.log('[TL-DIAG][04-header][page] utag.js loaded', a); };
        d.onerror = function(){ console.error('[TL-DIAG][04-header][page] utag.js failed', a); };
        a = b.getElementsByTagName(c)[0];
        a.parentNode.insertBefore(d,a);
    })();
</script>
<!-- Tealium utag footprint END -->

    
    
    

    

    
    
    
